# Client / Browser Safe (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_APP_URL=https://your-deployment-domain.vercel.app

# Server-Only (Vercel Serverless Functions / NEVER prefix with VITE_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DEVICE_HMAC_MASTER_SALT=replace-with-32-byte-random-hex

# Optional Email Delivery Provider (Resend) — left blank queues notifications honestly without sending
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@your-verified-domain.com
ADMIN_ALERT_EMAIL=koyaneniyaswanth@gmail.com
